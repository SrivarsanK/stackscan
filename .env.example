# StackScan Environment Variables Template
# Copy this file to '.env' and fill in your values.

# 1. GitHub OAuth App credentials (create one at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# 2. Redirect callback URI (must match the callback URL configured in GitHub OAuth settings)
# For local development, this defaults to: http://localhost:4321/api/auth/callback
GITHUB_REDIRECT_URI=http://localhost:4321/api/auth/callback

# 3. Server-side Personal Access Token fallback (Optional)
# Used when scanning profiles of other users while not logged in, to avoid rate-limiting.
# GITHUB_PAT=your_personal_access_token_here
